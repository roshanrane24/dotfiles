/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    bg0:    #2B3339;
    bg1:    #323D43;
    bg2:    #4C566A80;
    bg3:    #A7C080;
    fg0:    #D3C6AA;
    fg1:    #ECEFF4;
    fg2:    @bg3;
    fg3:    #4C566A;
}

@import "rounded-common.rasi"

element selected {
    text-color: @bg1;
}
