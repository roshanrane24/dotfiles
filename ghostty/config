window-padding-x = 5
window-padding-y = 5

title = GhosTTY
macos-titlebar-style = hidden
gtk-titlebar = false

font-size = 10
font-family = "SpaceMono Nerd Font"
font-family-bold = "SpaceMono Nerd Font"
font-family-italic = "SpaceMono Nerd Font"
font-family-bold-italic = "SpaceMono Nerd Font"

font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"

mouse-scroll-multiplier = 2
mouse-hide-while-typing = true

cursor-opacity = 0.8
cursor-style = block
cursor-style-blink = true

theme = tokyo-night-moon
