[Unit]
Description=KDE Connect Tray Indicator
Documentation=https://userbase.kde.org/KDEConnect
# order startup after WM
After=app-org.kde.kdeconnect.daemon@autostart.service

[Service]
Type=exec
# Repurpose XDG Autostart filtering
ExecStart=/usr/bin/kdeconnect-indicator
Restart=on-failure
RestartSec=10s
